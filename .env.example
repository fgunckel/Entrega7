# ADA API — Pre-entrega 7 (sin secretos reales)
# Copiar a .env y completar con valores reales.

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Groq) ---
GROQ_API_KEY=

# --- Observabilidad: Arize Phoenix ---
# Opción A (recomendada): Phoenix local con docker-compose (UI en http://localhost:6006)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Opción cloud: PHOENIX_ENDPOINT + PHOENIX_API_KEY (o usar LangSmith)
PHOENIX_PROJECT_NAME=ada-api

# --- LangSmith (alternativa a Phoenix) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ada-entrega7

# --- API ---
ADA_API_HOST=0.0.0.0
ADA_API_PORT=8000
ADA_MAX_STEPS=8
ADA_MAX_RETRIES=2

# --- Human-in-the-loop ---
# Umbral de costo estimado (USD) que marca una tarea como crítica y
# dispara la pausa HITL (interrupt) antes de ejecutar especialistas.
ADA_HITL_COST_THRESHOLD=0.50

# --- Costo por ejecución ---
# Tarifas por modelo en USD por millón de tokens (JSON). Si se omite, se
# usan tarifas por defecto para los modelos de Groq más comunes. Si el
# proveedor no informa tokens, el costo se registra como no disponible.
# ADA_MODEL_RATES={"llama-3.1-8b-instant": {"input": 0.05, "output": 0.08}}

# --- Emulador de Redis en memoria (solo tests locales, sin Docker) ---
# ADA_USE_FAKEREDIS=1
